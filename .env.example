# ---------------------------------------------------------------------------
# .env.example — copy to .env locally; mirror in Railway service variables.
# Never commit .env.
# ---------------------------------------------------------------------------

# --- Django ---
DJANGO_SECRET_KEY=replace-me-with-a-real-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Local Postgres via docker-compose. Railway auto-injects DATABASE_URL in prod.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lglp_dev

# --- Feature flags ---
# When False, the app runs as the fixture user `wesley@local` (auto-created)
# and bypasses Google OAuth. Set True once OAuth env vars are configured.
ENABLE_AUTH=False

# --- Google OAuth (django-allauth) ---
# Create OAuth credentials at https://console.cloud.google.com.
# Authorized redirect URI: <your-app-url>/accounts/google/login/callback/
# Production: https://weskirk.dev/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Comma-separated allowlist. Only these emails can sign in for v0.1.
GOOGLE_OAUTH_ALLOWED_EMAILS=j.wesley.kirk@gmail.com

# --- AI (OpenRouter) ---
# When unset, narration text falls back to a simple template; logs skip message.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- Audio (ElevenLabs) ---
# When unset, TTS steps are skipped and logged.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=TmNe0cCqkZBMwPWOd3RD
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Storage & scheduling ---
# Railway Volume mount path for audio files (segments, DBR, topics, sessions).
RAILWAY_VOLUME_PATH=/data
# Hour in Pacific time for nightly compile job (default 3 = 3:00 AM).
BUILD_TIME_HOUR=3
# Hour in Pacific time for RSS poll + MP3 download (default 2 = 2:30 AM).
DBR_INGEST_HOUR=2
